{
  "files.associations": {
    "*.luau": "luau"
  },
  "[luau]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  "luau-lsp.platform.type": "roblox",
  "luau-lsp.sourcemap.enabled": true,
  "luau-lsp.sourcemap.autogenerate": true,
  "luau-lsp.sourcemap.generatorCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 sourcemap",
  "luau-lsp.sourcemap.useVSCodeWatcher": true,
  "luau-lsp.sourcemap.rojoProjectFile": "default.project.json",
  "luau-lsp.sourcemap.includeNonScripts": true,
  "luau-lsp.diagnostics.strictDatamodelTypes": true,
  "stylua.searchBinaryInPATH": true,
  "terminal.integrated.env.windows": {
    "PATH": "${env:USERPROFILE}\\.rokit\\bin;${env:PATH}"
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/dist/**": true,
    "**/.cache/**": true,
    "**/.luau/**": true,
    "**/test-results/**": true
  },
  "search.exclude": {
    "**/build/**": true,
    "**/dist/**": true,
    "**/.cache/**": true,
    "**/.luau/**": true,
    "**/test-results/**": true,
    "sourcemap.json": true
  }
}