{
  "name": "REALSTEEL",
  "serveAddress": "127.0.0.1",
  "servePort": 34880,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$className": "Folder",
        "$path": "src/shared",
        "$ignoreUnknownInstances": true
      },
      "Tests": {
        "$className": "Folder",
        "FightSimSpec": {
          "$path": "tests/FightSimSpec.luau"
        },
        "RobotSpec": {
          "$path": "tests/RobotSpec.luau"
        },
        "BotSpec": {
          "$path": "tests/BotSpec.luau"
        },
        "LoadoutSpec": {
          "$path": "tests/LoadoutSpec.luau"
        },
        "GarageSpec": {
          "$path": "tests/GarageSpec.luau"
        },
        "GarageServerSpec": {
          "$path": "tests/GarageServerSpec.luau"
        },
        "QueueSpec": {
          "$path": "tests/QueueSpec.luau"
        },
        "LayoutSpec": {
          "$path": "tests/LayoutSpec.luau"
        },
        "PadSpec": {
          "$path": "tests/PadSpec.luau"
        },
        "StandingsSpec": {
          "$path": "tests/StandingsSpec.luau"
        },
        "RecordsSpec": {
          "$path": "tests/RecordsSpec.luau"
        },
        "WalletSpec": {
          "$path": "tests/WalletSpec.luau"
        },
        "CasesSpec": {
          "$path": "tests/CasesSpec.luau"
        },
        "RewardsSpec": {
          "$path": "tests/RewardsSpec.luau"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/server",
      "$ignoreUnknownInstances": true
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "EnableMouseLockOption": false,
        "CameraMinZoomDistance": 3
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/client",
        "$ignoreUnknownInstances": true
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "StreamingEnabled": true,
        "AuthorityMode": "Server",
        "NextGenerationReplication": "Enabled",
        "PlayerScriptsUseInputActionSystem": "Enabled",
        "SignalBehavior": "Deferred",
        "UseFixedSimulation": "Enabled"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true,
        "Brightness": 0.6,
        "ClockTime": 0,
        "Ambient": [0.5, 0.5, 0.54],
        "OutdoorAmbient": [0.2, 0.2, 0.23],
        "EnvironmentDiffuseScale": 0.45,
        "EnvironmentSpecularScale": 0.45,
        "ExposureCompensation": 0.15
      },
      "Sky": {
        "$className": "Sky",
        "$properties": {
          "StarCount": 0,
          "CelestialBodiesShown": false,
          "SkyboxBk": "",
          "SkyboxDn": "",
          "SkyboxFt": "",
          "SkyboxLf": "",
          "SkyboxRt": "",
          "SkyboxUp": ""
        }
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.24,
          "Offset": 0.1,
          "Color": [0.22, 0.21, 0.22],
          "Decay": [0.12, 0.1, 0.1],
          "Glare": 0,
          "Haze": 1
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.16,
          "Size": 14,
          "Threshold": 1.5
        }
      },
      "ColorGrade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Contrast": 0.04,
          "Saturation": -0.06,
          "TintColor": [1, 0.98, 0.95]
        }
      },
      "Depth": {
        "$className": "DepthOfFieldEffect",
        "$properties": {
          "FarIntensity": 0.08,
          "FocusDistance": 30,
          "InFocusRadius": 40,
          "NearIntensity": 0
        }
      }
    }
  }
}